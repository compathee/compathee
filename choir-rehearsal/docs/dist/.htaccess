DirectoryIndex index.html index.htm
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
	RewriteEngine On
	# ?lang=xx becomes the clean language URL. A cookie lets the browser remember it.
	# Browser-language detection is not done here; crawlers must see the URL they requested.
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:en|eng)(?:&|$) [NC]
	RewriteRule ^ /? [R=301,L,CO=choir-rehearsal-lang:en:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:et|est)(?:&|$) [NC]
	RewriteRule ^ /et/? [R=301,L,CO=choir-rehearsal-lang:et:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:ru|rus)(?:&|$) [NC]
	RewriteRule ^ /ru/? [R=301,L,CO=choir-rehearsal-lang:ru:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:de|deu|ger)(?:&|$) [NC]
	RewriteRule ^ /de/? [R=301,L,CO=choir-rehearsal-lang:de:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:fr|fra|fre)(?:&|$) [NC]
	RewriteRule ^ /fr/? [R=301,L,CO=choir-rehearsal-lang:fr:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:it|ita)(?:&|$) [NC]
	RewriteRule ^ /it/? [R=301,L,CO=choir-rehearsal-lang:it:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:es|esp|spa)(?:&|$) [NC]
	RewriteRule ^ /es/? [R=301,L,CO=choir-rehearsal-lang:es:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:sv|swe)(?:&|$) [NC]
	RewriteRule ^ /sv/? [R=301,L,CO=choir-rehearsal-lang:sv:rehearsal.compath.ee:525600:/]
	RewriteCond %{QUERY_STRING} (?:^|&)lang=(?:fi|fin)(?:&|$) [NC]
	RewriteRule ^ /fi/? [R=301,L,CO=choir-rehearsal-lang:fi:rehearsal.compath.ee:525600:/]
</IfModule>

<IfModule mod_authz_core.c>
	Require all granted
</IfModule>

<IfModule mod_authz_host.c>
	Order allow,deny
	Allow from all
</IfModule>

<IfModule mod_mime.c>
	AddType image/svg+xml .svg
	AddType application/manifest+json .webmanifest
	AddType image/x-icon .ico
</IfModule>
