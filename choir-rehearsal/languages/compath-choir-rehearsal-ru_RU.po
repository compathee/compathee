msgstr "Choir Rehearsal"

msgid "Microphone recording is available in Choir Rehearsal Pro."
msgstr "Запись с микрофона доступна в Choir Rehearsal Pro."

msgid "You are not allowed to upload recordings for this song."
msgstr "У вас нет прав загружать записи для этой песни."

msgid "No recording was uploaded."
msgstr "Запись не была загружена."

msgid "Recording upload was blocked by the server."
msgstr "Сервер заблокировал загрузку записи."

msgid "Could not save the recording in the Media Library."
msgstr "Не удалось сохранить запись в медиатеке."

msgid "Recording is too large for the server upload limit."
msgstr "Запись слишком большая для лимита загрузки сервера."

msgid "Recording was only partially uploaded."
msgstr "Запись загружена только частично."

