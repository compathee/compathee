msgstr "Эта песня закрытая"

msgid "Track"
msgstr "Трек"

msgid "Tracks"
msgstr "Треки"

msgid "Turns off every Lite copy except the one you chose. Does not delete files."
msgstr "Отключает все копии Lite, кроме выбранной. Файлы не удаляет."

msgid "Two octave piano keyboard"
msgstr "Клавиатура фортепиано на две октавы"

msgid "Unlimited tracks, microphone recording, search by song title, and Play preview in the editor. Keep this Lite plugin installed — Pro is a separate add-on."
msgstr "Неограниченные дорожки, запись с микрофона, поиск по названию и Play-превью в редакторе. Оставьте Lite установленным — Pro это отдельное дополнение."

msgid "Unlimited voice tracks, microphone recording, song search, and Play preview in the editor."
msgstr "Неограниченные голосовые дорожки, запись с микрофона, поиск песен и Play-превью в редакторе."

msgid "Update available: Compath Choir Rehearsal %s. Use Update now below or on the Plugins screen."
msgstr "Доступно обновление: Compath Choir Rehearsal %s. Нажмите «Обновить сейчас» ниже или на экране «Плагины»."

msgid "Update JSON URL"
msgstr "URL JSON обновлений"

msgid "Updates are delivered through WordPress.org."
msgstr "Обновления доставляются через WordPress.org."

msgid "Updates are published at %s"
msgstr "Обновления публикуются по адресу %s"

msgid "Upload"
msgstr "Загрузить"

msgid "Upload / Select PDF"
msgstr "Загрузить / Выбрать PDF"

msgid "Upload a PDF score. It appears below like on the public song page — swipe left/right to change pages while you record."
msgstr "Загрузите PDF-партитуру. Она отображается ниже, как на публичной странице — листайте страницы свайпом во время записи."

msgid "Upload failed. Please try again."
msgstr "Загрузка не удалась. Попробуйте снова."

msgid "Uploading…"
msgstr "Загрузка…"

msgid "Use recording"
msgstr "Использовать запись"

msgid "Use this audio"
msgstr "Использовать это аудио"

msgid "Use this PDF"
msgstr "Использовать этот PDF"

msgid "Used when Update JSON URL is empty. Each Lite release should include compath-choir-rehearsal.zip and update.json assets."
msgstr "Используется, когда Update JSON URL пуст. Каждый Lite-релиз должен включать файлы compath-choir-rehearsal.zip и update.json."

msgid "Username or email"
msgstr "Имя пользователя или email"

msgid "Version"
msgstr "Версия"

msgid "View Song"
msgstr "Смотреть песню"

msgid "Visibility"
msgstr "Видимость"

msgid "Voice"
msgstr "Голос"

msgid "Voice parts look like the public song page. Use the icons on the right to upload, record, or play."
msgstr "Партии выглядят как на публичной странице. Иконки справа — загрузка, запись или воспроизведение."

msgid "Voice Tracks"
msgstr "Треки по голосам"

msgid "Voice tracks"
msgstr "Голосовые дорожки"

msgid "Voice Type"
msgstr "Тип голоса"

msgid "Voice Types"
msgstr "Типы голосов"

msgid "WordPress page that shows the song list. Must contain the [choir_rehearsal] shortcode. You can add this page to your site menu under Appearance → Menus."
msgstr "Страница WordPress со списком песен. Должна содержать шорткод [choir_rehearsal]. Добавьте её в меню: Внешний вид → Меню."

msgid "Yes"
msgstr "Да"

msgid "You are not allowed to upload recordings for this song."
msgstr "У вас нет прав загружать записи для этой песни."

msgid "You must sign in to view this song."
msgstr "Чтобы увидеть эту песню, нужно войти."

msgid "Your installed version is %1$s, but the update server only reported %2$s (likely stale metadata). Open Plugins and use Update now if shown, upload the latest zip, or set Update JSON URL to the latest GitHub release update.json."
msgstr "Установлена версия %1$s, а сервер обновлений сообщил только %2$s (вероятно устаревшие метаданные). Откройте «Плагины» и нажмите «Обновить сейчас», загрузите актуальный zip или укажите Update JSON URL на update.json последнего GitHub release."

msgid "— Select —"
msgstr "— Выбрать —"


msgid "Hide video"
msgstr "Скрыть видео"

msgid "Optional. On the song page a button opens the official YouTube player (video stays visible). Not for downloading audio."
msgstr "Необязательно. На странице песни кнопка откроет официальный плеер YouTube (видео остаётся видимым). Не для скачивания аудио."

msgid "Watch reference video"
msgstr "Смотреть референс"

msgid "YouTube reference"
msgstr "Референс YouTube"

msgid "Audio"
msgstr "Аудио"

msgid "YouTube"
msgstr "YouTube"

