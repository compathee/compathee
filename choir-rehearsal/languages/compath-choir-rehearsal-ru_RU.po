msgid "List choir songs"
msgstr "Список песен хора"

msgid "Returns published rehearsal songs with track counts."
msgstr "Возвращает опубликованные песни с количеством треков."

msgid "Get choir song details"
msgstr "Детали песни хора"

msgid "Returns one song with all voice tracks and audio URLs."
msgstr "Возвращает одну песню со всеми голосами и URL аудио."

msgid "Security check failed. Please try again."
msgstr "Проверка безопасности не пройдена. Попробуйте снова."

msgid "Please enter your username and password."
msgstr "Введите имя пользователя и пароль."

msgid "Settings"
msgstr "Настройки"

msgid "Permalinks refreshed and rehearsal page verified."
msgstr "Постоянные ссылки обновлены, страница репетиций проверена."

msgid "Choir Rehearsal Settings"
msgstr "Настройки Choir Rehearsal"

msgid "Documentation"
msgstr "Документация"

msgid "Plugin documentation and changelog"
msgstr "Документация и журнал изменений плагина"

msgid "Product page: order, install, pricing, changelog"
msgstr "Страница продукта: заказ, установка, цены, журнал изменений"

msgid "Edition"
msgstr "Редакция"

#. translators: %d: maximum track count
#, php-format
msgid ""
"Lite: up to %d voice tracks per song; no microphone recording, song search, "
"or editor Play preview."
msgstr ""
"Lite: до %d голосовых дорожек на песню; без записи с микрофона, поиска песен "
"и Play-превью в редакторе."

msgid "Buy Pro"
msgstr "Купить Pro"

msgid ""
"Unlimited voice tracks, microphone recording, song search, and Play preview "
"in the editor."
msgstr ""
"Неограниченные голосовые дорожки, запись с микрофона, поиск песен и Play-"
"превью в редакторе."

msgid "Plugin version"
msgstr "Версия плагина"

msgid "Updates are delivered through WordPress.org."
msgstr "Обновления доставляются через WordPress.org."

#. translators: %s: GitHub releases link
#, php-format
msgid "Updates are published at %s"
msgstr "Обновления публикуются по адресу %s"

#. translators: 1: datetime, 2: version
#, php-format
msgid "Last check: %1$s — update available (%2$s)."
msgstr "Последняя проверка: %1$s — доступно обновление (%2$s)."

#. translators: %s: datetime
#, php-format
msgid "Last check: %s — up to date."
msgstr "Последняя проверка: %s — актуально."

#. translators: %s: datetime
#, php-format
msgid "Last check: %s — could not reach the update server."
msgstr "Последняя проверка: %s — сервер обновлений недоступен."

#. translators: %s: datetime
#, php-format
msgid "Last check: %s"
msgstr "Последняя проверка: %s"

msgid "Rehearsal page"
msgstr "Страница репетиций"

msgid "— Select —"
msgstr "— Выбрать —"

msgid ""
"WordPress page that shows the song list. Must contain the [choir_rehearsal] "
"shortcode. You can add this page to your site menu under Appearance → Menus."
msgstr ""
"Страница WordPress со списком песен. Должна содержать шорткод "
"[choir_rehearsal]. Добавьте её в меню: Внешний вид → Меню."

msgid "Require login"
msgstr "Только для авторизованных"

msgid "Only signed-in choir roles can open the full private library."
msgstr ""
"Полную закрытую библиотеку могут открыть только вошедшие пользователи с "
"ролями хора."

msgid "Choir roles"
msgstr "Роли хора"

msgid "browse and listen to the rehearsal library"
msgstr "просматривать и слушать библиотеку репетиций"

msgid "listen plus add/edit songs in the admin"
msgstr "слушать и добавлять/редактировать песни в админке"

msgid "full access including plugin Settings"
msgstr "полный доступ, включая настройки плагина"

msgid "Update JSON URL"
msgstr "URL JSON обновлений"

msgid ""
"Optional override. If empty, the plugin checks GitHub Releases, then falls "
"back to the latest release asset update.json."
msgstr ""
"Необязательное переопределение. Если пусто, плагин проверяет GitHub "
"Releases, затем берёт update.json из последнего релиза."

msgid "GitHub repository"
msgstr "Репозиторий GitHub"

msgid ""
"Used when Update JSON URL is empty. Each Lite release should include compath-"
"choir-rehearsal.zip and update.json assets."
msgstr ""
"Используется, когда Update JSON URL пуст. Каждый Lite-релиз должен включать "
"файлы compath-choir-rehearsal.zip и update.json."

msgid "Choir Rehearsal Pro"
msgstr "Choir Rehearsal Pro"

msgid ""
"Unlimited tracks, microphone recording, search by song title, and Play "
"preview in the editor. Keep this Lite plugin installed — Pro is a separate "
"add-on."
msgstr ""
"Неограниченные дорожки, запись с микрофона, поиск по названию и Play-превью "
"в редакторе. Оставьте Lite установленным — Pro это отдельное дополнение."

msgid "Check for plugin updates"
msgstr "Проверить обновления плагина"

msgid "Contacts GitHub Releases and shows the result on this page."
msgstr "Обращается к GitHub Releases и показывает результат на этой странице."

msgid "Refresh permalinks"
msgstr "Обновить постоянные ссылки"

#. translators: %s: library page URL
#, php-format
msgid "Song list URL: %s"
msgstr "URL списка песен: %s"

msgid "Edit rehearsal page"
msgstr "Редактировать страницу репетиций"

msgid "Appearance → Menus"
msgstr "Внешний вид → Меню"

msgid "Tracks"
msgstr "Треки"

msgid "Score"
msgstr "Ноты"

msgid "Visibility"
msgstr "Видимость"

msgid "Public"
msgstr "Публичная"

msgid "Private"
msgstr "Приватная"

msgid "Back to song list"
msgstr "Назад к списку песен"

msgid ""
"Add the song title, upload a PDF score, then record or upload each voice "
"part."
msgstr ""
"Добавьте название, загрузите PDF-партитуру, затем запишите или загрузите "
"каждую партию."

msgid ""
"Add the song title, upload a PDF score, then upload each voice part (up to 4 "
"tracks in Lite)."
msgstr ""
"Добавьте название, загрузите PDF-партитуру, затем каждую партию (до 4 "
"дорожек в Lite)."

msgid "Make private"
msgstr "Сделать приватной"

msgid "Make public"
msgstr "Сделать публичной"

msgid "Anyone can view and listen without signing in."
msgstr "Смотреть и слушать можно без входа."

msgid "Only signed-in users can access this song (when login is required)."
msgstr "Доступ только для вошедших пользователей (если требуется вход)."

msgid "Sheet Music (PDF)"
msgstr "Партитура (PDF)"

msgid "Voice Tracks"
msgstr "Треки по голосам"

msgid "Expand PDF"
msgstr "Развернуть PDF"

msgid "Close full screen"
msgstr "Закрыть полный экран"

msgid "Now playing"
msgstr "Сейчас играет"

msgid "Play"
msgstr "Играть"

msgid "Pause"
msgstr "Пауза"

msgid "Close player"
msgstr "Закрыть плеер"

msgid "Preview video"
msgstr "Предпросмотр видео"

msgid "Hide video"
msgstr "Скрыть видео"

msgid "Open piano"
msgstr "Открыть фортепиано"

msgid "Close piano"
msgstr "Закрыть фортепиано"

msgid "Open metronome"
msgstr "Открыть метроном"

msgid "Close metronome"
msgstr "Закрыть метроном"

msgid "Start"
msgstr "Старт"

msgid "Stop"
msgstr "Стоп"

msgid "Upload"
msgstr "Загрузить"

msgid "Record"
msgstr "Запись"

msgid "Use this audio"
msgstr "Использовать это аудио"

msgid "Remove"
msgstr "Удалить"

msgid "Track"
msgstr "Трек"

msgid "No audio selected"
msgstr "Аудио не выбрано"

msgid "Audio"
msgstr "Аудио"

msgid "YouTube"
msgstr "YouTube"

msgid "YouTube URL"
msgstr "Ссылка YouTube"

msgid ""
"Official YouTube player opens on the song page (video stays visible). Not "
"for downloading audio."
msgstr ""
"На странице песни откроется официальный плеер YouTube (видео остаётся "
"видимым). Не для скачивания аудио."

msgid "Select PDF"
msgstr "Выбрать PDF"

msgid "Use this PDF"
msgstr "Использовать этот PDF"

msgid "No PDF selected"
msgstr "PDF не выбран"

msgid "Remove PDF"
msgstr "Удалить PDF"

msgid "Sheet music"
msgstr "Партитура"

msgid "Previous"
msgstr "Назад"

msgid "Next"
msgstr "Вперёд"

msgid "Swipe left or right to change pages"
msgstr "Свайп влево или вправо для смены страниц"

msgid "Start recording"
msgstr "Начать запись"

msgid "Pause recording"
msgstr "Пауза записи"

msgid "Resume recording"
msgstr "Продолжить запись"

msgid "Use recording"
msgstr "Использовать запись"

msgid "Cancel"
msgstr "Отмена"

msgid "Recording…"
msgstr "Запись…"

msgid "Paused"
msgstr "Пауза"

msgid "Click start and sing your voice part."
msgstr "Нажмите старт и спойте свою партию."

msgid "Uploading…"
msgstr "Загрузка…"

msgid "Microphone access was denied."
msgstr "Доступ к микрофону запрещён."

msgid "Microphone recording is not supported in this browser."
msgstr "Этот браузер не поддерживает запись с микрофона."

msgid "Upload failed. Please try again."
msgstr "Загрузка не удалась. Попробуйте снова."

msgid "Save the song first, then you can record voice tracks."
msgstr "Сначала сохраните песню, затем можно записывать партии."

#. translators: %d: maximum track count
#, php-format
msgid ""
"Lite edition allows up to %d voice tracks per song. Upgrade to Pro for "
"unlimited tracks, microphone recording, and Play preview in the editor."
msgstr ""
"В Lite до %d голосовых дорожек на песню. Pro даёт неограниченные дорожки, "
"запись с микрофона и Play-превью в редакторе."

msgid ""
"Upload a PDF score. It appears below like on the public song page — swipe "
"left/right to change pages while you record."
msgstr ""
"Загрузите PDF-партитуру. Она отображается ниже, как на публичной странице — "
"листайте страницы свайпом во время записи."

msgid "Upload / Select PDF"
msgstr "Загрузить / Выбрать PDF"

msgid "Swipe to change pages · pinch to zoom"
msgstr "Свайп — смена страниц · щипок — масштаб"

msgid "No PDF selected yet."
msgstr "PDF пока не выбран."

msgid "Previous page"
msgstr "Предыдущая страница"

msgid "Next page"
msgstr "Следующая страница"

msgid "Close"
msgstr "Закрыть"

msgid ""
"Voice parts look like the public song page. Use the icons on the right to "
"upload, record, or play."
msgstr ""
"Партии выглядят как на публичной странице. Иконки справа — загрузка, запись "
"или воспроизведение."

#. translators: 1: max tracks, 2: upgrade link HTML
#, php-format
msgid ""
"Add one voice part per row (up to %1$d in Lite). Upload audio with the icon "
"on the right. %2$s"
msgstr ""
"Добавьте по одной партии в строке (в Lite до %1$d). Загрузите аудио иконкой "
"справа. %2$s"

msgid "Add one voice part per row. Upload audio with the icon on the right."
msgstr "Добавьте по одной партии в строке. Загрузите аудио иконкой справа."

msgid "Add track"
msgstr "Добавить трек"

msgid "Voice"
msgstr "Голос"

msgid "Track source"
msgstr "Источник трека"

#. translators: 1: song title, 2: voice label
#, php-format
msgid "%1$s — %2$s"
msgstr "%1$s — %2$s"

msgid "Sorry, you are not allowed to manage options."
msgstr "У вас нет прав на управление настройками."

msgid "Could not create the demo audio file in the Media Library."
msgstr "Не удалось создать демо-аудиофайл в медиатеке."

#. translators: 1: first song number, 2: last song number, 3: song count, 4: track count
#, php-format
msgid "Loaded demo songs %1$d–%2$d (%3$d songs, %4$d tracks)."
msgstr "Загружены демо-песни %1$d–%2$d (%3$d песен, %4$d дорожек)."

#. translators: 1: songs deleted, 2: tracks deleted, 3: media deleted
#, php-format
msgid "Deleted %1$d songs, %2$d tracks, and %3$d media files."
msgstr "Удалено %1$d песен, %2$d дорожек и %3$d медиафайлов."

msgid "Demo library"
msgstr "Демо-библиотека"

#. translators: 1: songs created per click, 2: songs shown per library page
#, php-format
msgid ""
"Load %1$d sample songs (4 voice tracks each) so the public library shows "
"pagination (%2$d songs per page), or wipe the whole rehearsal library."
msgstr ""
"Загрузить %1$d примерных песен (по 4 дорожки), чтобы публичная библиотека "
"показала постраничность (%2$d на странице), или очистить всю библиотеку "
"репетиций."

msgid "Load demo songs"
msgstr "Загрузить демо-песни"

msgid "All songs will be deleted from the library. Do you agree?"
msgstr "Все песни будут удалены из библиотеки. Согласны?"

msgid "Delete all songs"
msgstr "Удалить все песни"

msgid "Yes"
msgstr "Да"

msgid "No"
msgstr "Нет"

msgid "Pro"
msgstr "Pro"

msgid "Lite"
msgstr "Lite"

msgid "Security check failed. Reload the page and try again."
msgstr ""
"Проверка безопасности не пройдена. Обновите страницу и попробуйте снова."

msgid "Sending…"
msgstr "Отправка…"

msgid "Send"
msgstr "Отправить"

msgid "View issue"
msgstr "Открыть задачу"

msgid "Could not send feedback. Please try again later."
msgstr "Не удалось отправить отзыв. Попробуйте позже."

msgid "Send feedback"
msgstr "Отправить отзыв"

msgid "Wish, bug, or other note about Choir Rehearsal."
msgstr "Пожелание, ошибка или другая заметка о Choir Rehearsal."

msgid "Type"
msgstr "Тип"

msgid "Bug"
msgstr "Ошибка"

msgid "Wish"
msgstr "Пожелание"

msgid "Other"
msgstr "Другое"

msgid "Title"
msgstr "Заголовок"

msgid "Short summary"
msgstr "Краткое описание"

msgid "Description"
msgstr "Описание"

msgid "What happened, or what you wish for"
msgstr "Что случилось или какое у вас пожелание"

msgid "Contact email (optional)"
msgstr "Контактный email (необязательно)"

msgid "Feedback"
msgstr "Отзыв"

msgid "GitHub repository for feedback"
msgstr "Репозиторий GitHub для отзывов"

msgid ""
"Issues are created in this repository. Use owner/name, for example compathee/"
"compathee."
msgstr ""
"Задачи создаются в этом репозитории. Укажите owner/name, например compathee/"
"compathee."

msgid "GitHub token"
msgstr "Токен GitHub"

msgid "A token is saved."
msgstr "Токен сохранён."

msgid "Remove saved token"
msgstr "Удалить сохранённый токен"

msgid ""
"Create a fine-grained personal access token at GitHub → Settings → Developer "
"settings → Personal access tokens → Fine-grained tokens. Grant only this "
"repository Issues: Read and write. Paste the token here. It stays on the "
"server and is not shown on the rehearsal page. Leave blank to keep the saved "
"token."
msgstr ""
"Создайте fine-grained personal access token: GitHub → Settings → Developer "
"settings → Personal access tokens → Fine-grained tokens. Выдайте только "
"этому репозиторию право Issues: Read and write. Вставьте токен сюда. Он "
"хранится на сервере и не показывается на странице репетиций. Пустое поле "
"сохраняет текущий токен."

msgid ""
"That GitHub token does not look valid. The saved token was left unchanged."
msgstr ""
"Этот токен GitHub не похож на действительный. Сохранённый токен не изменён."

#. translators: %d: GitHub issue number
#, php-format
msgid "Thank you. Feedback sent as issue #%d."
msgstr "Спасибо. Отзыв отправлен как задача #%d."

msgid "Thank you. Feedback sent."
msgstr "Спасибо. Отзыв отправлен."

msgid "Please enter a type, title, and description."
msgstr "Укажите тип, заголовок и описание."

msgid "Feedback is not configured."
msgstr "Форма отзывов не настроена."

msgid "Please wait before sending more feedback."
msgstr "Подождите перед отправкой следующего отзыва."

msgid "Edit"
msgstr "Изменить"

#. translators: %d: number of tracks
#, php-format
msgid "%d track"
msgid_plural "%d tracks"
msgstr[0] "%d трек"
msgstr[1] "%d трека"
msgstr[2] "%d треков"

#. translators: %d: number of tracks
#, php-format
msgid "%d tracks"
msgstr "%d треков"

msgid "PDF score attached"
msgstr "Прикреплён PDF с нотами"

msgid "Public — available without login"
msgstr "Публичная — доступна без входа"

msgid "Has YouTube track"
msgstr "Есть трек YouTube"

msgid "Link copied to clipboard"
msgstr "Ссылка скопирована в буфер"

msgid "Could not copy the link. Please copy it from the address bar."
msgstr "Не удалось скопировать ссылку. Скопируйте её из адресной строки."

msgid "Watch video"
msgstr "Смотреть видео"

msgid "YouTube video player"
msgstr "Видеоплеер YouTube"

msgid "Sign in for the full library"
msgstr "Войдите для полной библиотеки"

msgid ""
"Public songs above are open to everyone. Sign in with your WordPress account "
"to access the full rehearsal library."
msgstr ""
"Публичные песни выше открыты всем. Войдите через WordPress, чтобы открыть "
"полную библиотеку репетиций."

msgid "Rehearsal Library"
msgstr "Библиотека репетиций"

msgid ""
"Sign in with your WordPress account to access songs, sheet music, and voice "
"tracks."
msgstr ""
"Войдите через учётную запись WordPress, чтобы открыть песни, ноты и треки по "
"голосам."

msgid "Username or email"
msgstr "Имя пользователя или email"

msgid "Password"
msgstr "Пароль"

msgid "Remember me"
msgstr "Запомнить меня"

msgid "Sign in"
msgstr "Войти"

msgid "Forgot your password?"
msgstr "Забыли пароль?"

msgid "Signed in as"
msgstr "Вы вошли как"

msgid "Add song"
msgstr "Добавить песню"

msgid "Manage library"
msgstr "Управление библиотекой"

msgid "Sign out"
msgstr "Выйти"

msgid "Full library requires a choir role"
msgstr "Для полной библиотеки нужна роль хора"

msgid "This song is private"
msgstr "Эта песня закрытая"

msgid "Public songs"
msgstr "Публичные песни"

msgid "Search songs"
msgstr "Поиск песен"

msgid "Search by title…"
msgstr "Поиск по названию…"

msgid ""
"No public songs yet. Sign in below for the full library, or ask an editor to "
"make a song public."
msgstr ""
"Публичных песен пока нет. Войдите ниже для полной библиотеки или попросите "
"редактора сделать песню публичной."

msgid "No songs yet."
msgstr "Песен пока нет."

msgid "Add the first song"
msgstr "Добавить первую песню"

msgid "These songs are open to listen and view without signing in."
msgstr "Эти песни можно слушать и смотреть без входа."

msgid "No songs match your search."
msgstr "Поиск не дал результатов."

msgid "Song list pages"
msgstr "Страницы списка песен"

#. translators: 1: first song number on page, 2: last song number on page, 3: total songs
#, php-format
msgid "Showing %1$d–%2$d of %3$d songs"
msgstr "Показано %1$d–%2$d из %3$d песен"

msgid "All songs"
msgstr "Все песни"

msgid "Share"
msgstr "Поделиться"

msgid "Edit song"
msgstr "Изменить песню"

msgid "Voice tracks"
msgstr "Голосовые дорожки"

msgid "No tracks uploaded yet."
msgstr "Треки ещё не загружены."

msgid "Seek"
msgstr "Перемотка"

msgid "Piano"
msgstr "Фортепиано"

msgid "Two octave piano keyboard"
msgstr "Клавиатура фортепиано на две октавы"

msgid "Metronome"
msgstr "Метроном"

msgid "BPM"
msgstr "BPM"

msgid "Tempo"
msgstr "Темп"

#. translators: 1: folder from zip, 2: installed folder
#, php-format
msgid "Could not map update folder %1$s to installed folder %2$s."
msgstr ""
"Не удалось сопоставить папку обновления %1$s с установленной папкой %2$s."

msgid ""
"Compath Choir Rehearsal is loaded from more than one folder. Open the "
"migration wizard to keep one copy and remove the extras. Songs stay in the "
"database."
msgstr ""
"Compath Choir Rehearsal загружен из нескольких папок. Откройте мастер "
"миграции, чтобы оставить одну копию и удалить лишние. Песни остаются в базе."

msgid "Open migration wizard"
msgstr "Открыть мастер миграции"

msgid "Fix duplicate install"
msgstr "Исправить двойную установку"

msgid "Choir Rehearsal migration"
msgstr "Миграция Choir Rehearsal"

msgid ""
"Multiple Compath Choir Rehearsal (Lite) folders were found. Use the "
"migration wizard before relying on Pro or updates."
msgstr ""
"Найдено несколько папок Compath Choir Rehearsal (Lite). Используйте мастер "
"миграции перед работой с Pro или обновлениями."

msgid "Missing or unreadable"
msgstr "Отсутствует или нечитаем"

msgid ""
"Choir Rehearsal: duplicate Lite entries were removed from active plugins. "
"Reload this page if Pro or features still look inactive."
msgstr ""
"Choir Rehearsal: дублирующие записи Lite удалены из активных плагинов. "
"Обновите страницу, если Pro или функции всё ещё неактивны."

msgid "Sorry, you are not allowed to manage plugins."
msgstr "У вас нет прав на управление плагинами."

msgid "Fix duplicate Choir Rehearsal install"
msgstr "Исправить двойную установку Choir Rehearsal"

msgid ""
"Migration finished. Only one Lite folder should remain. You can activate Pro "
"now if needed."
msgstr ""
"Миграция завершена. Должна остаться одна папка Lite. При необходимости "
"активируйте Pro."

msgid ""
"active_plugins repaired. Reload this page (F5) so Lite and Pro load cleanly."
msgstr ""
"active_plugins исправлен. Обновите страницу (F5), чтобы Lite и Pro "
"загрузились корректно."

msgid ""
"After 0.4.39 the package folder was renamed for WordPress.org. Uploading a "
"newer zip beside an existing choir-rehearsal/ folder creates a second copy. "
"This wizard keeps one folder and removes the extras. Song data in the "
"database is not deleted."
msgstr ""
"После 0.4.39 папка пакета переименована для WordPress.org. Загрузка нового "
"zip рядом с choir-rehearsal/ создаёт вторую копию. Мастер оставляет одну "
"папку и удаляет лишние. Данные песен в базе не удаляются."

msgid "Only one Lite install was found on disk. No cleanup needed."
msgstr "На диске найдена только одна установка Lite. Очистка не нужна."

msgid ""
"Only one Lite folder exists on disk, but WordPress still lists more than one "
"Lite plugin as active (or a missing path). This breaks Pro and updates. Use "
"the repair button below, then reload wp-admin."
msgstr ""
"На диске одна папка Lite, но WordPress считает активными несколько записей "
"Lite (или путь отсутствует). Это ломает Pro и обновления. Нажмите кнопку "
"исправления ниже и обновите wp-admin."

msgid "Step 1 — Installs found"
msgstr "Шаг 1 — найденные установки"

msgid "Folder"
msgstr "Папка"

msgid "Version"
msgstr "Версия"

msgid "Plugin name"
msgstr "Имя плагина"

msgid "On disk"
msgstr "На диске"

msgid "Active"
msgstr "Активен"

msgid "Missing"
msgstr "Нет"

msgid "Lite rows in active_plugins"
msgstr "Записи Lite в active_plugins"

msgid "file missing"
msgstr "файл отсутствует"

msgid "Repair active_plugins"
msgstr "Исправить active_plugins"

msgid ""
"Keeps choir-rehearsal/ (or the only folder on disk), removes ghost or "
"duplicate Lite entries. Does not delete songs."
msgstr ""
"Оставляет choir-rehearsal/ (или единственную папку на диске), удаляет "
"призрачные или дублирующие записи Lite. Песни не удаляет."

msgid "Repair active plugins list"
msgstr "Исправить список активных плагинов"

msgid "Step 2 — Choose folder to keep"
msgstr "Шаг 2 — выберите папку для сохранения"

msgid "recommended for existing sites"
msgstr "рекомендуется для существующих сайтов"

msgid "Save choice"
msgstr "Сохранить выбор"

msgid "Step 3 — Deactivate other copies"
msgstr "Шаг 3 — деактивировать другие копии"

msgid ""
"Turns off every Lite copy except the one you chose. Does not delete files."
msgstr "Отключает все копии Lite, кроме выбранной. Файлы не удаляет."

msgid "Deactivate other Lite plugins"
msgstr "Деактивировать другие Lite-плагины"

msgid "Step 4 — Delete other folders"
msgstr "Шаг 4 — удалить другие папки"

msgid ""
"Deletes extra plugin folders from disk only. Does not run uninstall and does "
"not delete songs."
msgstr ""
"Удаляет с диска только лишние папки плагина. Не запускает uninstall и не "
"удаляет песни."

msgid ""
"Delete every Lite folder except the one you chose? Songs in the database "
"will NOT be deleted."
msgstr ""
"Удалить все папки Lite, кроме выбранной? Песни в базе данных НЕ будут "
"удалены."

msgid "Delete other folders"
msgstr "Удалить другие папки"

msgid "Step 5 — Activate kept copy"
msgstr "Шаг 5 — активировать сохранённую копию"

msgid "Activate kept Lite plugin"
msgstr "Активировать сохранённый Lite"

msgid "Invalid keep folder."
msgstr "Некорректная папка для сохранения."

msgid "Choose which folder to keep first."
msgstr "Сначала выберите, какую папку оставить."

msgid "Could not delete some folders (use FTP). "
msgstr "Не удалось удалить некоторые папки (используйте FTP). "

msgid "Keep folder is missing. Re-upload Lite into choir-rehearsal/."
msgstr ""
"Папка для сохранения отсутствует. Загрузите Lite снова в choir-rehearsal/."

msgid "Refusing to delete that path."
msgstr "Отказ удалять этот путь."

msgid "Could not read plugin folder."
msgstr "Не удалось прочитать папку плагина."

